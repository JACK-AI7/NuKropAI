// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  scans     Scan[]
  chats     Chat[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Scan {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  imageUrl      String
  plantName     String
  diseaseName   String
  cause         String?
  severity      String   // low, medium, high
  confidence    Float
  treatment     String
  fertilizer    String?
  pesticide     String?
  soilType      String?
  soilHealth    String?
  isSoilAnalysis Boolean  @default(false)
  latitude      Float?
  longitude     Float?
  weather       String?  // JSON: {temp, humidity, windSpeed, weatherCode}
  aiModel       String?  // Which AI model processed this scan: 'mistral' | 'ollama' | 'yolo' | 'database' | 'tflite'
  modelVersion  String?  // Model version identifier (e.g., 'yolo11s-pest-detection-v1')
  pestDetections String? // JSON array of pest detections for YOLO: [{species, confidence, bbox}]
  modelConfidence Float? // Overall confidence from the model (for YOLO: max detection confidence)
  processingTime  Float?  // Inference time in seconds
  createdAt     DateTime @default(now())
}

model Chat {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  response  String
  createdAt DateTime @default(now())
}
